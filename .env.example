# Password for the dashboard login (required in production)
ADMIN_PASSWORD=change-me

# Mixed into the signature on the login cookie. Any long random string: `openssl rand -hex 32`.
# Without it the app still works, but a stolen cookie becomes a guess at the password itself.
# Changing it signs everyone out.
AUTH_SECRET=

# Second login for the leader who only picks bonuses: read-only everywhere else.
# Leave empty to switch that account off.
BONUS_PASSWORD=

# API key for clashwithjpa.com, from https://clashwithjpa.com/dashboard/api-keys.
# Manager scope is enough. Only `npm run sync-pn` reads it, from .env.local — the deployed app
# never calls that API, so this does not need to be set in Vercel.
JPA_API_KEY=

# Clash of Clans API token. Create it at developer.clashofclans.com and whitelist 45.79.218.79 (RoyaleAPI proxy).
COC_API_TOKEN=
# Leave as-is to use the RoyaleAPI proxy (works on any host).
COC_API_BASE=https://cocproxy.royaleapi.dev/v1

# Supabase Postgres connection string (Transaction pooler, port 6543).
# Leave empty locally to use the built-in embedded database in ./.data
DATABASE_URL=

# Protects the daily cron endpoint. Vercel sends it automatically as a Bearer token.
CRON_SECRET=

# Google service account for "Export to Google Sheet"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
